<?xml version="1.0"?>
<launch>

  <!-- ===================== -->
  <!--   Global Arguments    -->
  <!-- ===================== -->

  <arg name="use_sim_time" default="false"/>

  <arg name="namespace_supervisor"   default="supervisor"/>
  <arg name="namespace_executor"     default="executor"/>
  <arg name="namespace_planning"     default="planning"/>
  <arg name="namespace_navigation"   default="navigation"/>
  <arg name="namespace_manipulation" default="manipulation"/>
  <arg name="namespace_hardware"     default="hardware"/>
  <arg name="namespace_hri"          default="hri"/>
  <arg name="namespace_vision"          default="vision"/>
  <arg name="namespace_tasks"          default="tasks"/>
  <arg name="namespace_knowledge"          default="knowledge"/>

  <arg name="use_nav" default="true"/>
  <arg name="nav_use_pot_fields" default="true"/>
  <arg name="nav_cloud_downsampling" default="1"/>
  <arg name="nav_cloud_points_threshold" default="20"/>

  <!-- ===================== -->
  <!--      Supervisor       -->
  <!-- ===================== -->
  <include file="$(find-pkg-share supervisor_manager)/launch/supervisor.launch.xml">
    <arg name="namespace" value="$(var namespace_supervisor)"/>
  </include>

  <!-- ===================== -->
  <!--       Executor        -->
  <!-- ===================== -->
  <include file="$(find-pkg-share executor_tools)/launch/executor.launch.xml">
    <arg name="namespace" value="$(var namespace_executor)"/>
  </include>

  <!-- ===================== -->
  <!--       Planning        -->
  <!-- ===================== -->
  <include file="$(find-pkg-share planning_tools)/launch/planning.launch.xml">
    <arg name="namespace" value="$(var namespace_planning)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <!-- ===================== -->
  <!--      Navigation       -->
  <!-- ===================== -->
  <include file="$(find-pkg-share navigation_tools)/launch/navigation.launch.xml"
           if="$(var use_nav)">
    <arg name="namespace" value="$(var namespace_navigation)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="use_pot_fields" value="$(var nav_use_pot_fields)"/>
    <arg name="cloud_downsampling" value="$(var nav_cloud_downsampling)"/>
    <arg name="cloud_points_threshold" value="$(var nav_cloud_points_threshold)"/>
  </include>

  <!-- ===================== -->
  <!--     Manipulation      -->
  <!-- ===================== -->
  <include file="$(find-pkg-share manipulation_tools)/launch/manipulation.launch.xml">
    <arg name="namespace" value="$(var namespace_manipulation)"/>
  </include>

  <!-- ===================== -->
  <!--       Hardware        -->
  <!-- ===================== -->
  <include file="$(find-pkg-share hardware_tools)/launch/hardware.launch.xml">
    <arg name="namespace" value="$(var namespace_hardware)"/>
  </include>

  <!-- ===================== -->
  <!--         HRI           -->
  <!-- ===================== -->
  <include file="$(find-pkg-share hri_tools)/launch/hri.launch.xml">
    <arg name="namespace" value="$(var namespace_hri)"/>
  </include>

  <!-- ===================== -->
  <!--        Vision         -->
  <!-- ===================== -->
  <include file="$(find-pkg-share vision_tools)/launch/vision.launch.xml">
    <arg name="namespace" value="$(var namespace_vision)"/>
  </include>

  <!-- ===================== -->
  <!--      Knowledge        -->
  <!-- ===================== -->
  <include file="$(find-pkg-share knowledge_tools)/launch/knowledge.launch.xml">
    <arg name="namespace" value="$(var namespace_knowledge)"/>
  </include>


  <!-- ===================== -->
  <!--        RViz2          -->
  <!-- ===================== -->
  <node pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        output="screen"
        args="-d $(find-pkg-share surge_et_ambula)/rviz/justina.rviz"/>

</launch>
